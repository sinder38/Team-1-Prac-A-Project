# Copy this file to .env and fill in your keys
OPENROUTER_API_KEY=your_openrouter_api_key
FRED_API_KEY=your_fred_api_key  # only required when macro = true in pipeline.toml
NEWSDATA_API_KEY=your_newsdata_api_key

# Only needed for local testing with provider = "ollama" in pipeline.toml / server.toml
OLLAMA_HOST=http://localhost:11434
# Request timeout in seconds. CPU inference on a full pipeline prompt can take
OLLAMA_TIMEOUT=600
