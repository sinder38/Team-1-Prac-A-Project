# Copy this file to .env and fill in your keys
OPENROUTER_API_KEY=your_openrouter_api_key
FRED_API_KEY=your_fred_api_key  # only required when macro = true in pipeline.toml
NEWSDATA_API_KEY=your_newsdata_api_key

# Single administrator account. Blank values keep all write operations disabled.
# Set these only in your local .env file. Use SESSION_COOKIE_SECURE=1 with HTTPS.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=0

# Only needed for local testing with provider = "ollama" in pipeline.toml / server.toml
OLLAMA_HOST=http://localhost:11434
# Request timeout in seconds. CPU inference on a full pipeline prompt can take
OLLAMA_TIMEOUT=600
